FROM python:3.12-slim-bookworm

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    PORT=8080

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system app \
    && adduser --system --ingroup app --home /app --no-create-home app

COPY requirements.txt .
# Upgrade pip + setuptools together: setuptools>=78.1.1 fixes CVE-2025-47273 (path traversal),
# kept <81 to preserve pkg_resources for transitive deps that still import it.
RUN python -m pip install --upgrade pip "setuptools>=78.1.1,<81" \
    && python -m pip install -r requirements.txt

COPY --chown=app:app . .
RUN mkdir -p /app/uploads \
    && chown -R app:app /app

USER app

EXPOSE 8080

CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-8080} --workers ${WEB_CONCURRENCY:-2} --timeout ${GUNICORN_TIMEOUT:-120} --access-logfile - --error-logfile - wsgi:app"]
